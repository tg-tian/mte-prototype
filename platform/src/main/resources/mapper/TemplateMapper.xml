<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="demo.lowcode.platform.mapper.TemplateMapper">

    <resultMap id="templateResultMap" type="demo.lowcode.platform.entity.Template">
        <id property="id" column="id"/>
        <result property="template_id" column="template_id"/>
        <result property="name" column="name"/>
        <result property="template_index" column="template_index"/>
        <result property="template_description" column="template_description"/>
        <result property="example_image_url" column="example_image_url"/>
        <result property="code_url" column="code_url"/>
        <result property="repository_url" column="repository_url"/>
        <result property="file_source" column="file_source"/>
        <result property="submitter" column="submitter"/>
        <result property="license" column="license"/>
        <result property="code_file" column="code_file"/>
        <result property="tags" column="tags"/>
        <result property="created_at" column="created_at"/>
        <result property="updated_at" column="updated_at"/>
    </resultMap>

    <!--获取领域模板列表-->
    <select id="getDomainTemplate" resultMap="templateResultMap">
        SELECT * FROM template
        WHERE template_id IN (
            SELECT template_id FROM domain_template
            WHERE domain_code = #{domainCode}
        )
    </select>

    <!--根据template_id查询模板-->
    <select id="selectByTemplateId" resultMap="templateResultMap">
        SELECT * FROM template WHERE template_id = #{templateId}
    </select>

</mapper>