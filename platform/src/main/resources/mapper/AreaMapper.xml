<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="demo.lowcode.platform.mapper.AreaMapper">
    <!-- 显式定义结果映射，确保数据库列正确映射到实体字段 -->
    <resultMap id="AreaResultMap" type="demo.lowcode.platform.entity.Area">
        <id property="pk" column="id"/>
        <result property="id" column="area_id"/>
        <result property="name" column="name"/>
        <result property="sceneId" column="scene_id"/>
        <result property="description" column="description"/>
        <result property="image" column="image"/>
        <result property="polygon" column="polygon"/>
        <result property="parentId" column="parent_id"/>
    </resultMap>

    <update id="updateParentByAreaIds">
        UPDATE area
        SET parent_id = #{parentId}
        WHERE area_id IN
        <foreach collection="children" item="childAreaId" open="(" separator="," close=")">
            #{childAreaId}
        </foreach>
    </update>

    <update id="deleteParentByAreaId">
        UPDATE area
        SET parent_id = -1
        WHERE area_id = #{areaId}
    </update>

    <!-- 根据场景 ID 获取区域列表 -->
    <select id="selectBySceneId" resultMap="AreaResultMap">
        SELECT * FROM area
        WHERE scene_id = #{sceneId}
    </select>

    <select id="selectByAreaIdValue" resultMap="AreaResultMap">
        SELECT * FROM area WHERE area_id = #{areaId}
    </select>

    <update id="updateByAreaIdValue">
        UPDATE area
        SET name        = #{area.name},
            scene_id    = #{area.sceneId},
            description = #{area.description},
            image       = #{area.image},
            polygon     = #{area.polygon},
            parent_id   = #{area.parentId}
        WHERE area_id = #{areaId}
    </update>

    <delete id="deleteByAreaIdValue">
        DELETE FROM area WHERE area_id = #{areaId}
    </delete>

    <select id="selectByParentIdValue" resultMap="AreaResultMap">
        SELECT * FROM area WHERE parent_id = #{parentId}
    </select>

</mapper>
